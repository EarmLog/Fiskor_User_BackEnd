# Plantilla de variables de entorno de Fiskor ERP
# Copie este archivo como .env y complete los valores reales.

FISKOR_JWT_SECRET=cambie_esta_clave_por_una_larga_y_segura
FISKOR_JWT_HORAS=12
FISKOR_ENTORNO=desarrollo
FISKOR_SQLITE_RUTA=

SUPABASE_HOST=db.xxxxxxxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=su_password
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=su_anon_key

TASA_API_URL=https://v6.exchangerate-api.com/v6/SU_API_KEY/latest/USD
TASA_MONEDA=USD
TASA_MONEDA_DESTINO=VES

ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiemela
ADMIN_NOMBRE=Administrador

FISKOR_IGTF=3.0
FISKOR_IVA=16.0

# --- Registro de usuarios y recuperacion de contrasena ---
# URL publica del frontend (para armar los enlaces de correo).
FISKOR_URL_FRONTEND=http://localhost:5173
# Minutos de validez del enlace de recuperacion.
FISKOR_MINUTOS_TOKEN=60
# Exigir aprobacion del administrador para activar cada registro.
# false = el usuario queda activo al instante (registro abierto).
FISKOR_REGISTRO_APROBACION=false

# --- Correo saliente (SMTP) ---
# Si se deja vacio, Fiskor registra el correo en el log y, en
# desarrollo, devuelve el enlace de recuperacion en la respuesta.
FISKOR_SMTP_HOST=
FISKOR_SMTP_PORT=587
FISKOR_SMTP_USUARIO=
FISKOR_SMTP_CLAVE=
FISKOR_SMTP_TLS=true
FISKOR_CORREO_REMITENTE=no-responder@fiskor.local
FISKOR_CORREO_NOMBRE=Fiskor ERP

# --- Impresora fiscal (SENIAT) ---
# Puerto serie/USB: Linux /dev/ttyUSB0, Windows COM3.
FISKOR_IMPRESORA_PUERTO=/dev/ttyUSB0
FISKOR_IMPRESORA_BAUDIOS=9600
FISKOR_IMPRESORA_TIMEOUT=3
# Protocolo: HKA, THE_FACTORY o GENERICO.
FISKOR_IMPRESORA_PROTOCOLO=HKA
# Deje true para probar sin hardware real (simula la impresion).
FISKOR_IMPRESORA_SIMULAR=true
